# ---- Network (Concordium testnet) ----
CCD_NETWORK=ccd:4221332d34e1694168c2a0c0b3fd0f27
CCD_GRPC_HOST=grpc.testnet.concordium.com
CCD_GRPC_PORT=20000
REGISTRY_API=https://agent-registry-mcp.concordium.com
REGISTRY_NETWORK=testnet

# ---- Facilitator (Cord operator: sponsors every payment's network fee) ----
FACILITATOR_PORT=4020
FACILITATOR_URL=http://localhost:4020
CCD_FACILITATOR_ADDRESS=
CCD_FACILITATOR_PRIVATE_KEY=

# ---- Seller agent: TenderScout ----
SELLER_PORT=4021
SELLER_URL=http://localhost:4021
SELLER_PAY_TO=
# Badge (CIS-8004 token address, Base58Check short form) of the seller agent once registered
SELLER_BADGE=
SELLER_TOKEN_ID=
SELLER_OWNER=
# ---- Settlement asset for supplier INVOICES ----
# CCD (default): demo mode, each EUR settles as a small CCD amount (DEMO_ATOMIC_PER_EUR below).
# EURR / USDR / any PLT stablecoin: invoices settle at FULL value (EUR 1,850 = 1,850 EURR).
# Run `npm run doctor` to list the tokens on the network and check ProcureBot's balance.
INVOICE_ASSET=CCD
# Decimals of INVOICE_ASSET (doctor checks this against the chain). EURR and USDR use 6.
INVOICE_ASSET_DECIMALS=6
# EUR value of one token for non-euro tokens, e.g. ASSET_EUR_USDR=0.86. Tokens named EUR* default to 1.
# Without a rate the owner's policy refuses payments in that token (the agent never guesses a rate).
# ASSET_EUR_USDR=

# ---- Price per DATA call (tenders, benchmarks) in atomic units. CCD has 6 decimals: 100000 = 0.1 CCD.
PRICE_ASSET=CCD
PRICE_TENDERS=100000
PRICE_BENCHMARK=250000
# Refuse to serve buyers that do not present a valid badge (true/false)
REQUIRE_BUYER_BADGE=true

# ---- Buyer agent: ProcureBot ----
CCD_ADDRESS=
CCD_PRIVATE_KEY=
BUYER_BADGE=
BUYER_TOKEN_ID=
BUYER_OWNER=
# Hard spend cap per single payment, atomic units
MAX_PAYMENT=1000000
# Assets the buyer may pay in (x402 spend controls). Must include INVOICE_ASSET.
# (Once you've saved the Policy tab, data/policy.json overrides this: add the token there too.)
ALLOWED_ASSETS=CCD,EURR,USDR,EURC
# Set to false only for local testing before your agents are registered
REQUIRE_SELLER_BADGE=true

# ---- Settlement on Base Sepolia and Solana devnet (EURC) ----
# Created by `npm run wallets` (never paste real-money keys here). Leave empty to settle on Concordium only.
# Invoices marked chain "base" / "solana" in src/seller/data.ts settle there in Circle's EURC, through the free
# public x402 facilitator (it pays the network fees, so neither agent needs ETH or SOL).
# ProcureBot (pays)
BUYER_EVM_PRIVATE_KEY=
BUYER_SOLANA_SECRET_KEY=
# TenderScout (gets paid). The EVM public key lets buyers look the address up in the CIS-8 registry;
# the private keys are only used once, by `npm run link-keys`, to prove the keys to Concordium.
SELLER_EVM_ADDRESS=
SELLER_EVM_PUBLIC_KEY=
SELLER_EVM_PRIVATE_KEY=
SELLER_SOLANA_ADDRESS=
SELLER_SOLANA_SECRET_KEY=
# Optional overrides (defaults shown)
# XCHAIN_FACILITATOR_URL=https://x402.org/facilitator
# EURC_BASE=0x808456652fdb597867f38412077A9182bf77359F
# EURC_SOLANA=HzwqbKZw8HxMN6bF2yFZNrht3c2iXXzpKcFu7uBEDKtr
# BASE_RPC_URL=https://sepolia.base.org
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Demo scale: EUR value of 1 EURC (1000 => EUR 1,000 settles as 1 EURC). Set 1 for full value.
# ASSET_EUR_EURC=1000

# ---- Agent Registry (testnet contracts, from the registry's badge-check response) ----
REGISTRY_CONTRACT=12802.0
CIS8_CONTRACT=12801.0

# ---- Owner dashboard (npm run web) ----
APP_NAME=Kakasa
WEB_PORT=4030
# Keep on localhost: this server holds the buyer key and can pay invoices.
WEB_HOST=127.0.0.1
# Owner limits in demo EUR (the Policy tab saves overrides to data/policy.json)
MAX_PER_LOCK_EUR=10000
DAILY_LIMIT_EUR=10000
# CCD demo settlement rate: CCD atomic units per EUR (100 => EUR 1,000 settles as 0.1 CCD on testnet)
DEMO_ATOMIC_PER_EUR=100

# ---- Owner wallet approval (Release must be signed by the owner's Concordium wallet) ----
# Accounts allowed to sign releases (comma separated). Default: BUYER_OWNER, else CCD_ADDRESS.
OWNER_ACCOUNTS=
REQUIRE_OWNER_SIGNATURE=true
# Mobile wallet via WalletConnect: free project id from https://cloud.reown.com
WALLETCONNECT_PROJECT_ID=

# ---- ProcureBot chat (Agent tab in the owner dashboard) ----
# Leave empty: the free built-in assistant runs on your computer (no API cost).
# Optional: set a Claude API key to let Claude drive the same tools (billed per message).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Owner login + phone access (npm run remote) ----
# Set a strong password (12+ characters) to require sign-in on the dashboard and allow the private phone link.
# Leave empty to use the dashboard on this computer only (requests through a tunnel are then refused).
DASHBOARD_PASSWORD=

# ---- Judge demo mode (optional) ----
# A separate password (8+ characters) for hackathon judges. They sign in with it, create small demo invoices and
# release them without the owner's wallet: testnet only, demo invoices only, capped below. Owner-only actions
# (policy, pause, anchoring, key links) stay closed to them. Leave empty to turn judge demo mode off.
JUDGE_PASSWORD=
# Or no passwords at all: anyone on the remote link (npm run all -- --remote) is a judge straight away, with the
# same limits; on this computer you are the owner without signing in.
JUDGE_OPEN=false
# JUDGE_MAX_PER_LOCK_EUR=2000
# JUDGE_DAILY_LIMIT_EUR=5000

# Public site only (Vercel): the fee-sponsor's ADDRESS (never its key) so the site can show its balance.
# PUBLIC_FACILITATOR_ADDRESS=
